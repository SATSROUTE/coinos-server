  liquid: {
    host: "lq",
    wallet: "coinos",
    user: "admin1",
    password: "123",
    network: "regtest",
    port: 7040,
    btc: "5ac9f65c0efcc4775e0baec4ec03abdde22473cd3cf33c0419ca290e0751b225"
  },
  lightning: "/home/bun/app/data/lightning/regtest/lightning-rpc",
  lightningb: "/home/bun/app/data/lightningb/regtest/lightning-rpc",
  fee: 0.001,
  // SECURITY: the admin login path is disabled when this is empty (fails
