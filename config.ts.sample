  // --- Controles de saque (lib/withdrawals.ts) ---
  // Sobreponiveis por usuario no KeyDB: limit:<uid> e daylimit:<uid>.
  //
  // Estes dois nao dependem do modelo de negocio, entao ja vem ligados:
  velocityMax: 10,         // maximo de saques por janela
  velocityWindow: 3600,    // janela da velocidade, em segundos
  newAddressCooloff: 3600, // carencia para endereco de destino nunca visto
  //
  // Estes dependem de quanto voce quer que um usuario movimente. 0 = desligado.
