  //   node -e "import('nostr-tools').then(n=>console.log(n.nip19.nsecEncode(n.generateSecretKey())))"
  nostrKey: "nsec1replacewithafreshlygeneratedkeydonotusethissamplevalue0",
  nostrKey2: "nsec1replacewithafreshlygeneratedkeydonotusethissamplevalue1",
  // Validade dos tokens de sessao. Antes eles nao expiravam: um token vazado
