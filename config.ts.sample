  // legitimo, e nenhum teto deixa uma conta invadida drenar sem freio.
  userLimitSats: 0,        // teto por pagamento, por usuario
  dayLimitSats: 0,         // teto acumulado no dia, por usuario
  tokenTtl: "30d",
  // Reconciliacao ledger x nos (lib/reconcile.ts). Intervalo em segundos;
